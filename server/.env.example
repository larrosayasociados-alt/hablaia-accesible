# Copy to server/.env and fill the values there. Never commit the copy.
# With nothing else set, the server listens on 127.0.0.1:8787 and every
# speech stage is the offline mock. That mock does not understand Spanish.

# HABLAIA_BIND=127.0.0.1:8787
# HABLAIA_PUBLIC_WS_URL=ws://127.0.0.1:8787/xiaozhi/v1/
# HABLAIA_TOKEN_SECRET=
# HABLAIA_TOKEN_TTL_SECONDS=604800
# Comma-separated Wi-Fi MAC addresses. Empty rejects every device.
# HABLAIA_DEVICES=
# HABLAIA_ALLOW_ANY_DEVICE=0
# HABLAIA_CLIENT_IDS=
# HABLAIA_LOG_LEVEL=INFO
# HABLAIA_FRAME_PACE_MS=60
# HABLAIA_TTS_PREROLL_MS=200

# LLM. Use mock, or openai for any Chat Completions API.
# EU inference on Mistral is https://api.eu.mistral.ai/v1 — confirm the model
# is listed for that endpoint before relying on it.
# HABLAIA_LLM_PROVIDER=mock
# HABLAIA_LLM_BASE_URL=https://api.eu.mistral.ai/v1
# HABLAIA_LLM_API_KEY=
# HABLAIA_LLM_MODEL=
# HABLAIA_LLM_TOKEN_FIELD=max_tokens

# STT. mock, openai (/audio/transcriptions, language=es) or azure.
# HABLAIA_STT_PROVIDER=mock
# HABLAIA_STT_BASE_URL=https://api.openai.com/v1
# HABLAIA_STT_API_KEY=
# HABLAIA_STT_MODEL=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_LANGUAGE=es-ES

# TTS. mock, openai (/audio/speech) or azure neural es-ES.
# HABLAIA_TTS_PROVIDER=mock
# HABLAIA_TTS_BASE_URL=
# HABLAIA_TTS_API_KEY=
# HABLAIA_TTS_MODEL=
# HABLAIA_TTS_VOICE=
# AZURE_SPEECH_VOICE=es-ES-ElviraNeural
